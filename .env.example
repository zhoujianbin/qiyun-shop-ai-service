# 栖云智家 一期 环境变量样例（复制为 .env 后填写，禁止提交真实密钥）
APP_ENV=dev
APP_NAME=栖云智家企业电商基础平台
TENANT_ID=1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/qiyun_shop_dev   # 共用实例请改成自己的库名，如 qiyun_shop_dev_<你的名字>
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173
PAYMENT_PROVIDER=mock
DEMO_MODE=true
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/uploads
LOG_LEVEL=INFO

# 三期：大模型（OpenAI 兼容端点）
# 已定供应商：DeepSeek；LLM_MODEL 用便宜的 deepseek-flash
# APP_ENV=test 时自动使用 fake provider，不联网、不需要 key
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-请填写你的key
LLM_TIMEOUT_SECONDS=60
ASSISTANT_CONTEXT_ROUNDS=6
ASSISTANT_MESSAGE_MAX_CHARS=2000
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
